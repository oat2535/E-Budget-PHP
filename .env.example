# Laravel Configuration
APP_NAME=E-Budget
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=false
APP_TIMEZONE=Asia/Bangkok
APP_URL=http://localhost:8000

# Session & Cache
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file

# 1. Project Database (imedx_tlp_for_it / schema: intra_tl)
