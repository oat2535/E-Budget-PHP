DB_PORT=5434
DB_DATABASE=imedx_tlp_for_it
DB_USERNAME=eservices
DB_PASSWORD=
DB_SCHEMA=intra_tl

# 2. iMedX User & Branch Database (imedx_uat / schema: public)
